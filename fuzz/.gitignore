# build artifacts
fuzz_prior
fuzz_decompress
gen_seeds
*.o
crash-*
leak-*
timeout-*
oom-*
# large valid prior seed is regenerated by `make seeds` (≥2MB bloom)
seeds_prior/valid.bcb-prior

# auto-written libFuzzer corpus units (hash-named); curated seeds only
seeds_prior/*
!seeds_prior/.gitkeep

# auto-written libFuzzer corpus units (hash-named); curated c_*.bin only
seeds_decompress/*
!seeds_decompress/c_*.bin
